---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const db = getDatabase();
const [games, filterCategories, filterPublishers] = await Promise.all([
  getAllGames(db),
  getAllCategories(db),
  getAllPublishers(db),
]);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <div class="flex flex-col gap-4 mb-6 sm:flex-row sm:items-end sm:justify-between">
        <h2 class="text-2xl font-medium text-slate-100">Featured Games</h2>

        {games.length > 0 && (
          <p class="text-sm text-slate-300" data-testid="filter-results" role="status" aria-live="polite">
            Showing {games.length} {games.length === 1 ? 'game' : 'games'}
          </p>
        )}
      </div>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <form class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-6" data-testid="game-filters">
            <fieldset>
              <legend class="mb-4 text-lg font-medium text-slate-100">Filter games</legend>

              <div class="grid gap-6 lg:grid-cols-[2fr_1fr_auto] lg:items-end">
                <div>
                  <span class="mb-3 block text-sm font-medium text-slate-200">Categories</span>
                  <div class="flex flex-wrap gap-3" data-testid="category-filters">
                    {filterCategories.map((category) => (
                      <label class="inline-flex cursor-pointer items-center gap-2 rounded-lg border border-slate-600 px-3 py-2 text-sm text-slate-200 transition-colors hover:border-blue-400 focus-within:ring-2 focus-within:ring-blue-500">
                        <input
                          type="checkbox"
                          value={category.id}
                          data-filter-category={category.id}
                          data-testid={`category-filter-${category.id}`}
                          class="h-4 w-4 accent-blue-500"
                        />
                        <span>{category.name}</span>
                      </label>
                    ))}
                  </div>
                </div>

                <label class="block text-sm font-medium text-slate-200">
                  <span class="mb-2 block">Publisher</span>
                  <select
                    data-filter-publisher
                    data-testid="publisher-filter"
                    class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
                  >
                    <option value="">All publishers</option>
                    {filterPublishers.map((publisher) => (
                      <option value={publisher.id}>{publisher.name}</option>
                    ))}
                  </select>
                </label>

                <button
                  type="reset"
                  data-testid="clear-filters"
                  class="rounded-lg border border-slate-600 px-4 py-2 text-sm font-medium text-slate-200 transition-colors hover:border-blue-400 hover:text-blue-300 focus:outline-none focus:ring-2 focus:ring-blue-500"
                >
                  Clear filters
                </button>
              </div>
            </fieldset>
          </form>

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <div hidden data-testid="filtered-empty-state">
            <EmptyState text="No games match the selected filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const categoryInputs = Array.from(
    document.querySelectorAll<HTMLInputElement>('[data-filter-category]'),
  );
  const publisherSelect = document.querySelector<HTMLSelectElement>('[data-filter-publisher]');
  const gameCards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const results = document.querySelector<HTMLElement>('[data-testid="filter-results"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');
  const filterForm = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');

  function applyFilters(): void {
    const selectedCategories = new Set(
      categoryInputs.filter((input) => input.checked).map((input) => input.value),
    );
    const selectedPublisher = publisherSelect?.value ?? '';
    let visibleCount = 0;

    for (const card of gameCards) {
      const categoryMatches =
        selectedCategories.size === 0 || selectedCategories.has(card.dataset.categoryId ?? '');
      const publisherMatches =
        selectedPublisher === '' || selectedPublisher === card.dataset.publisherId;
      const isVisible = categoryMatches && publisherMatches;

      card.hidden = !isVisible;
      if (isVisible) {
        visibleCount += 1;
      }
    }

    if (results) {
      results.textContent = `Showing ${visibleCount} ${visibleCount === 1 ? 'game' : 'games'}`;
    }
    if (emptyState) {
      emptyState.hidden = visibleCount > 0;
    }
  }

  categoryInputs.forEach((input) => input.addEventListener('change', applyFilters));
  publisherSelect?.addEventListener('change', applyFilters);
  filterForm?.addEventListener('reset', () => requestAnimationFrame(applyFilters));
</script>
